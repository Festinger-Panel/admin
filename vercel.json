{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index" },
    { "source": "/dashboard", "destination": "/admin/dashboard" },
    { "source": "/dashboard.html", "destination": "/admin/dashboard" },
    { "source": "/setup_fest", "destination": "/admin/setup_fest" },
    { "source": "/setup_fest.html", "destination": "/admin/setup_fest" },
    { "source": "/user_managment", "destination": "/admin/user_managment" },
    { "source": "/user_managment.html", "destination": "/admin/user_managment" },
    { "source": "/user_form", "destination": "/admin/user_form" },
    { "source": "/user_form.html", "destination": "/admin/user_form" },
    { "source": "/user_welcome", "destination": "/admin/user_welcome" },
    { "source": "/user_welcome.html", "destination": "/admin/user_welcome" },
    { "source": "/firebase_sync.js", "destination": "/admin/firebase_sync.js" },
    { "source": "/Asett/:path*", "destination": "/admin/Asett/:path*" }
  ]
}
